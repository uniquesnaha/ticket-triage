# ─── Groq API (OpenAI-Compatible LPU Inference) ──────────────────────────
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-free-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-120b

# (Optional fallback alias if using xAI/OpenAI)
# XAI_API_KEY=your-api-key-here

# ─── API Security ─────────────────────────────────────────────────────
# A secret key used to authenticate requests to the triage API.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TRIAGE_API_KEY=your-secret-triage-api-key-here

# ─── Application ──────────────────────────────────────────────────────
ENVIRONMENT=development     # development | production
LOG_LEVEL=INFO

# ─── CORS & Hosts ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Comma-separated list of allowed host headers
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Limits ───────────────────────────────────────────────────────────
MAX_TICKETS_PER_BATCH=50
MAX_TICKET_LENGTH=2000
MAX_CSV_SIZE_MB=5
TEMPERATURE=0.1
MAX_TOKENS=512
LLM_TIMEOUT=30
MAX_RETRIES=3

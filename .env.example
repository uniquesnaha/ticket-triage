# Copy to .env for local development:  cp .env.example .env
# On Vercel, set these in Project → Settings → Environment Variables instead.

# ─── LLM: Groq (OpenAI-compatible) ── required ──────────────────────────────
# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-120b
# Prompt file in backend/app/prompts/ (without .toml); change it to A/B test a prompt version
TRIAGE_PROMPT=triage

# ─── Application ────────────────────────────────────────────────────────────
# development | production (production disables /api/v1/docs)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated. Only needed for cross-origin callers (local Vite dev uses a proxy).
ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated Host allowlist. localhost is always allowed; on Vercel the
# deployment's own *.vercel.app domains are added automatically. Add custom domains here.
ALLOWED_HOSTS=

# ─── LLM tuning (optional) ──────────────────────────────────────────────────
TEMPERATURE=0.1
MAX_TOKENS=1024
# "" = auto (low for gpt-oss models); low | medium | high | none
LLM_REASONING_EFFORT=
# seconds per LLM request
LLM_TIMEOUT=20
# total attempts per ticket (malformed output + transient errors)
MAX_RETRIES=4
# parallel LLM calls per batch (mind your Groq rate limit)
LLM_CONCURRENCY=4
# seconds; keep below the Vercel function maxDuration (60)
BATCH_TIMEOUT=50

# ─── Limits (optional) ──────────────────────────────────────────────────────
MAX_TICKETS_PER_BATCH=50
MAX_TICKET_LENGTH=2000
# Vercel caps request bodies at 4.5 MB
MAX_CSV_SIZE_MB=4
RATE_LIMIT_TRIAGE=20/minute
RATE_LIMIT_UPLOAD=6/minute
